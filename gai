#!/usr/bin/env bash
# gai — AI git commit using local Ollama (qwen2.5-coder:1.5b)
# Usage: gai [--all] [--dry-run] [--force] [--version] [--logs]
#
#   Default (no flags): commit STAGED files one by one
#   --all              : commit ALL dirty files one by one
#   --dry-run          : print messages, don't commit
#   --force            : skip the secret checks for this run
#   --version          : print installed gai-tools version
#   --logs             : show last 24 h of activity

set -euo pipefail

MODEL="${GAI_MODEL:-qwen2.5-coder:1.5b}"
OLLAMA_URL="http://localhost:11434/api/generate"
DRY_RUN=false
FORCE=false
MODE="staged"
LOG_DIR="${GAI_LOG_DIR:-$HOME/.gai/logs}"

_prune_logs() {
  mkdir -p "$LOG_DIR"
  find "$LOG_DIR" -name "*.log" -mmin +1440 -delete 2>/dev/null || true
}

# ── arrow-key selection menu ──────────────────────────────────────────────────
# Sets global _MENU_RESULT to the 0-based index of the chosen item.

_gai_select_menu() {
  local _idx=0 _count=$# _key _esc _i _opt _cols _max _opts=() _drawn=0
  _cols=$(tput cols 2>/dev/null || echo 80)
  _max=$(( _cols - 4 ))
  for _opt in "$@"; do
    if [[ "${#_opt}" -gt "$_max" ]]; then
      _opts+=("${_opt:0:$(( _max - 1 ))}…")
    else
      _opts+=("$_opt")
    fi
  done
  tput civis 2>/dev/null || true
  _gai_menu_draw() {
    if [[ "$_drawn" -eq 1 ]]; then
      printf "\033[%dA" "$_count"
    fi
    _i=0
    for _opt in "${_opts[@]}"; do
      printf "\033[2K"
      if [[ "$_i" -eq "$_idx" ]]; then
        printf "  \033[7m▶ %s\033[0m\n" "$_opt"
      else
        printf "    %s\n" "$_opt"
      fi
      _i=$(( _i + 1 ))
    done
    _drawn=1
  }
  _gai_menu_draw
  while true; do
    IFS= read -rsn1 _key
    if [[ "$_key" == $'\x1b' ]]; then
      IFS= read -rsn2 -t 1 _esc || true
      case "$_esc" in
        '[A') if [[ "$_idx" -gt 0 ]]; then _idx=$(( _idx - 1 )); fi ;;
        '[B') if [[ "$_idx" -lt $(( _count - 1 )) ]]; then _idx=$(( _idx + 1 )); fi ;;
      esac
      _gai_menu_draw
    elif [[ "$_key" == '' || "$_key" == $'\r' ]]; then
      break
    fi
  done
  tput cnorm 2>/dev/null || true
  _MENU_RESULT=$_idx
}

# ── ollama helpers (shared by `gai pr` and `gai issue`) ───────────────────────

_gai_ollama_up() {
  curl -s --connect-timeout 2 "http://localhost:11434" > /dev/null 2>&1
}

# Seconds one generation may take before gai gives up on it. Empty means wait as
# long as the model needs — `gai pr` has nothing to fall back on, so it waits.
# `gai issue` sets a budget: on a box with no spare GPU or RAM a 1.5b model can
# grind for minutes, and attaching the issue matters more than a fresh title.
GAI_GEN_TIMEOUT="${GAI_GEN_TIMEOUT:-}"

# $1 = prompt text. Echoes the model response, or nothing on any failure.
# Returns 1 when the request itself failed (timeout included), 0 otherwise.
_gai_ollama_gen() {
  local _escaped _raw
  _escaped=$(python3 -c "import sys,json; print(json.dumps(sys.stdin.read()))" <<< "$1")
  local _curl=(curl -s --connect-timeout 10)
  if [[ -n "$GAI_GEN_TIMEOUT" ]]; then
    _curl+=(--max-time "$GAI_GEN_TIMEOUT")
  fi
  if ! _raw=$("${_curl[@]}" "$OLLAMA_URL" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"$MODEL\",\"prompt\":$_escaped,\"stream\":false}"); then
    return 1
  fi
  printf '%s' "$_raw" | python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
  print(d.get('response', '').strip())
except Exception:
  pass
" || true
}

# $1 = branch, $2 = commit list, $3 = issue context (optional).
_gai_gen_pr_title() {
  local _branch="$1" _commits="$2" _issues="${3:-}" _prompt _out _title

  _prompt="Generate a GitHub pull request title for this branch.
Reply with ONLY the title on one line. No explanation. No backticks. No quotes. No trailing period.
Format: type(scope): short description
Rules:
- type: one of feat fix refactor style docs test chore perf
- scope: single word naming the most specific component changed, taken from the
  Branch, Commits or Issues text below — never invented
- description: imperative mood, HARD LIMIT 50 chars after the colon
- Total title MUST be under 72 characters. Count carefully.
- Every word must come from the real work described below.

Branch: $_branch
Commits:
$_commits"

  if [[ -n "$_issues" ]]; then
    _prompt="${_prompt}

This PR closes the GitHub issues below. Base the title on what THEY ask for —
they describe the work far better than the commit list does. Rewrite the issue
title in the type(scope): format above:
$_issues"
  fi

  _out=$(_gai_ollama_gen "$_prompt") || return 1
  # Keep the first non-empty line and hard-truncate at a word boundary if the
  # model ignored the 72-char instruction.
  _title=$(printf '%s' "$_out" | python3 -c "
import re, sys
lines = [l.strip().strip('\"') for l in sys.stdin.read().splitlines() if l.strip()]
t = lines[0] if lines else ''
# The model sometimes stacks two conventional prefixes ('feat(a): fix(b): …').
# Drop the outer ones and keep the innermost, which names the real change.
pre = r'(feat|fix|refactor|style|docs|test|chore|perf)(\([^)]*\))?!?:\s*'
while re.match('^' + pre + pre, t):
  t = re.sub('^' + pre, '', t, count=1)
t = t.rstrip('.')
if len(t) > 72:
  t = t[:72].rsplit(' ', 1)[0].rstrip(',:;-')
  # Truncating mid-phrase can leave a dangling preposition ('… for secrets in').
  stop = {'in','to','for','of','on','at','the','a','an','and','or','with','from','by'}
  parts = t.split()
  while parts and parts[-1].lower() in stop:
    parts.pop()
  t = ' '.join(parts).rstrip(',:;-')
print(t)
")


  printf '%s\n' "$_title"
}

# $1 = branch, $2 = commit list, $3 = diffstat (optional), $4 = issue context (optional).
_gai_gen_pr_body() {
  local _branch="$1" _commits="$2" _diffstat="${3:-}" _issues="${4:-}" _changes _prompt
  if [[ -n "$_diffstat" ]]; then
    _changes="$_diffstat"
  else
    _changes="One bullet per commit, grouped by area."
  fi

  _prompt="Generate a GitHub pull request body in markdown.
Use this exact structure — fill every section with real content, no placeholders:

## What and why
2-3 sentences explaining: what problem or limitation existed before this PR, why it occurred (root cause), and what this PR does to fix or add it. Name the specific files, functions, or behaviors involved.

## Changes
$_changes

## Test plan
- [ ] Write specific, actionable test steps based on what actually changed. Not generic steps.

Reply with ONLY the markdown. No preamble. No backticks around the whole response.
Do NOT write any \"Closes #\", \"Fixes #\" or \"Resolves #\" line — those are appended separately.

Branch: $_branch
Commits:
$_commits"

  if [[ -n "$_issues" ]]; then
    _prompt="${_prompt}

## GitHub issues this PR closes
$_issues"
  fi

  _gai_ollama_gen "$_prompt"
}

# ── issue subcommand ──────────────────────────────────────────────────────────

# Compose the full issue thread (title, labels, body, comments) into a prompt and
# hand it to an interactive Claude session, so the user never re-types the URL.
_gai_issue_claude_session() {
  # Detaching an issue is the opposite of starting work on it — never offer.
  if [[ "$_issue_remove" == "true" ]]; then
    return 0
  fi

  if ! command -v claude > /dev/null 2>&1; then
    return 0
  fi

  if [[ ! -t 0 ]]; then
    echo "Not a TTY — skipping Claude session offer."
    echo "  Run manually: claude \"$_issue_url\""
    return 0
  fi

  echo ""
  read -rp "Start a Claude session on issue #${_issue_num} with full context? [Y/n] " _claude_confirm || true
  case "$_claude_confirm" in
    [Nn]*)
      echo "Skipped. Re-run any time: gai issue $_issue_url"
      return 0
      ;;
  esac

  echo "→ Fetching issue #${_issue_num} context…"
  _issue_ctx=$(gh issue view "$_issue_num" --repo "$_issue_repo" \
    --json title,body,labels,comments \
    --jq '
      "Title: \(.title)",
      "Labels: \([(.labels // [])[].name] | join(", ") | if . == "" then "none" else . end)",
      "",
      "## Description",
      ((.body // "") | if . == "" then "(no description)" else . end),
      ((.comments // []) | if length == 0 then empty else ("", "## Comments", (.[] | "--- @\(.author.login // "unknown") ---\n\(.body // "")")) end)
    ' || true)

  if [[ -z "$_issue_ctx" ]]; then
    echo "error: could not fetch issue #${_issue_num} from ${_issue_repo}." >&2
    return 1
  fi

  read -rp "Extra instructions (optional): " _extra || true

  _prompt="Work on GitHub issue #${_issue_num} in ${_issue_repo}.
${_issue_url}

${_issue_ctx}"

  if [[ -n "$_extra" ]]; then
    _prompt="${_prompt}

## Extra instructions from the user
${_extra}"
  fi

  if [[ "$_issue_dry_run" == "true" ]]; then
    echo ""
    echo "── dry run: prompt that would be sent to claude ──"
    echo "$_prompt"
    echo "─────────────────────────────────────────────────"
    return 0
  fi

  echo "→ Launching Claude session…"
  exec claude "$_prompt"
}

if [[ "${1:-}" == "issue" ]]; then
  _issue_arg=""
  _issue_dry_run=false
  _issue_remove=false

  shift
  for _arg in "$@"; do
    case "$_arg" in
      --dry-run|-n) _issue_dry_run=true ;;
      --remove|-r)  _issue_remove=true ;;
      -*)
        echo "error: unknown flag for 'gai issue': $_arg" >&2
        exit 1
        ;;
      *)
        if [[ -z "$_issue_arg" ]]; then
          _issue_arg="$_arg"
        fi
        ;;
    esac
  done

  if [[ -z "$_issue_arg" ]]; then
    echo "Usage: gai issue <issue-number|github-issue-url> [--remove] [--dry-run]" >&2
    exit 1
  fi

  if ! command -v gh > /dev/null 2>&1; then
    echo "error: gh CLI not installed." >&2
    echo "  Install: brew install gh && gh auth login" >&2
    exit 1
  fi

  if ! gh auth status > /dev/null 2>&1; then
    echo "error: gh CLI not authenticated. Run: gh auth login" >&2
    exit 1
  fi

  # A bare number (or "#123") means "the issue in the repo I'm standing in".
  if [[ "$_issue_arg" =~ ^#?[0-9]+$ ]]; then
    _issue_num="${_issue_arg#\#}"
    _issue_repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)

    if [[ -z "$_issue_repo" ]]; then
      echo "error: 'gai issue $_issue_arg' needs a GitHub repo in the current directory." >&2
      echo "  cd into the repo, or pass the full issue URL." >&2
      exit 1
    fi

    _issue_url="https://github.com/${_issue_repo}/issues/${_issue_num}"
    echo "→ Resolved #${_issue_num} → ${_issue_repo}"
  else
    _issue_url="$_issue_arg"
    # || true: set -e would otherwise abort on a non-matching grep before the
    # friendly error below ever prints.
    _issue_num=$(echo "$_issue_url" | grep -oE '/issues/[0-9]+' | grep -oE '[0-9]+' || true)
    _issue_repo=$(echo "$_issue_url" | grep -oE 'github\.com/[^/]+/[^/]+' | sed 's|github\.com/||' || true)

    if [[ -z "$_issue_num" || -z "$_issue_repo" ]]; then
      echo "error: invalid GitHub issue reference: $_issue_arg" >&2
      echo "  Expected: 123  or  https://github.com/owner/repo/issues/123" >&2
      exit 1
    fi
  fi

  echo "→ Fetching open PRs for ${_issue_repo}…"

  _pr_list=()
  while IFS= read -r _line; do
    [[ -n "$_line" ]] && _pr_list+=("$_line")
  done < <(gh pr list --repo "$_issue_repo" --state open --json number,title --jq '.[] | "\(.number)|\(.title)"')

  # Nothing to attach to — open a PR first so the issue has a home.
  if [[ ${#_pr_list[@]} -eq 0 ]]; then
    echo "No open PRs in ${_issue_repo}."

    # Nothing to detach from, and opening a PR to remove an issue from it is
    # nonsense — bail before the creation prompt.
    if [[ "$_issue_remove" == "true" ]]; then
      echo "error: --remove needs an open PR to remove #${_issue_num} from." >&2
      exit 1
    fi

    # --dry-run must never push a branch or open a PR.
    if [[ "$_issue_dry_run" == "true" ]]; then
      echo "dry run: would create a PR via 'gai pr', then attach #${_issue_num} to it."
      _gai_issue_claude_session
      exit 0
    fi

    if [[ ! -t 0 ]]; then
      echo "error: not a TTY — cannot confirm PR creation. Run 'gai pr' first." >&2
      exit 1
    fi

    read -rp "Create one now? [Y/n] " _mk_pr || true
    case "$_mk_pr" in
      [Nn]*)
        echo "Skipped PR creation — issue #${_issue_num} not attached."
        _gai_issue_claude_session
        exit 0
        ;;
    esac

    _cwd_repo=$(gh repo view --json nameWithOwner --jq '.nameWithOwner' 2>/dev/null || true)

    if [[ -z "$_cwd_repo" ]]; then
      echo "error: not inside a GitHub repository — cd into ${_issue_repo} and re-run." >&2
      exit 1
    fi

    if [[ "$_cwd_repo" != "$_issue_repo" ]]; then
      echo "error: you are in ${_cwd_repo}, but issue #${_issue_num} lives in ${_issue_repo}." >&2
      echo "  cd into ${_issue_repo} and re-run." >&2
      exit 1
    fi

    if ! "$0" pr; then
      echo "error: PR creation failed — issue #${_issue_num} not attached." >&2
      exit 1
    fi

    echo ""
    echo "→ Re-fetching open PRs for ${_issue_repo}…"

    _pr_list=()
    while IFS= read -r _line; do
      [[ -n "$_line" ]] && _pr_list+=("$_line")
    done < <(gh pr list --repo "$_issue_repo" --state open --json number,title --jq '.[] | "\(.number)|\(.title)"')

    if [[ ${#_pr_list[@]} -eq 0 ]]; then
      echo "error: PR created but it is not showing up in the open-PR list." >&2
      exit 1
    fi
  fi

  _pr_num=""
  if [[ ${#_pr_list[@]} -eq 1 ]]; then
    _pr_num=$(echo "${_pr_list[0]}" | cut -d'|' -f1)
    _pr_title=$(echo "${_pr_list[0]}" | cut -d'|' -f2)
    echo "→ Auto-selecting PR #$_pr_num: $_pr_title"
  else
    echo ""
    echo "Multiple open PRs — select one:"
    _pr_options=()
    for _entry in "${_pr_list[@]}"; do
      _n=$(echo "$_entry" | cut -d'|' -f1)
      _t=$(echo "$_entry" | cut -d'|' -f2)
      _pr_options+=("#$_n: $_t")
    done
    _gai_select_menu "${_pr_options[@]}"
    _idx=$_MENU_RESULT
    _pr_num=$(echo "${_pr_list[$_idx]}" | cut -d'|' -f1)
    _pr_title=$(echo "${_pr_list[$_idx]}" | cut -d'|' -f2)
  fi

  # Everything below is sourced from the PR itself, never from local git: the
  # selected PR may belong to a branch that is not checked out here, and
  # describing HEAD's commits in someone else's PR would be worse than useless.
  _pr_json=$(gh pr view "$_pr_num" --repo "$_issue_repo" --json headRefName,title,body,commits)

  _pr_body=$(echo "$_pr_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('body') or '')")
  _pr_head=$(echo "$_pr_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('headRefName') or '')")
  _pr_cur_title=$(echo "$_pr_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('title') or '')")
  _pr_commits=$(echo "$_pr_json" | python3 -c "
import sys, json
d = json.load(sys.stdin)
for c in (d.get('commits') or [])[:40]:
  print('- ' + (c.get('messageHeadline') or '').strip())
")

  # Collect every issue this PR already closes. All GitHub closing keywords
  # count: collecting only 'Closes' while stripping the rest would silently drop
  # a hand-written 'Fixes #9' and stop that issue from auto-closing.
  _close_re='(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]+#[0-9]+'
  _prev_nums=$(printf '%s\n' "$_pr_body" | grep -ioE "$_close_re" | grep -oE '[0-9]+' || true)

  if [[ "$_issue_remove" == "true" ]]; then
    if ! printf '%s\n' "$_prev_nums" | grep -qx "$_issue_num"; then
      echo "→ Issue #$_issue_num is not referenced in PR #$_pr_num — nothing to remove."
      exit 0
    fi

    # || true: with the last remaining number filtered out grep exits 1, and
    # set -e would kill the script right where an empty list is the point.
    _all_nums=$(printf '%s\n' "$_prev_nums" | grep -E '^[0-9]+$' | awk '!seen[$0]++' \
      | grep -vFx "$_issue_num" || true)
    echo "→ Removing #$_issue_num from PR #$_pr_num."
  else
    # First-seen order, new issue last.
    _all_nums=$(printf '%s\n%s\n' "$_prev_nums" "$_issue_num" | grep -E '^[0-9]+$' | awk '!seen[$0]++')

    if printf '%s\n' "$_prev_nums" | grep -qx "$_issue_num"; then
      echo "→ Issue #$_issue_num already referenced in PR #$_pr_num — refreshing title and body."
    fi
  fi

  # Strip the old closing region so it can be rebuilt in full, and drop the
  # trailing blank lines that stripping leaves behind.
  _pr_body_clean=$(printf '%s\n' "$_pr_body" \
    | grep -viE "^[[:space:]]*${_close_re}[[:space:]]*$" \
    | grep -v '^<!-- gai:closes -->$' \
    | python3 -c "import sys; print(sys.stdin.read().rstrip())" || true)

  # The collect regex is unanchored while the strip regex is whole-line only, so
  # a mid-sentence "also fixes #34" survives the rebuild — under --remove that is
  # a silent failure: the canonical line goes, GitHub still auto-closes the issue.
  if [[ "$_issue_remove" == "true" ]]; then
    # One pass with the number baked in: two chained greps would match the
    # keyword on one reference and the number on another ("Closes #12, see #34").
    _stray=$(printf '%s\n' "$_pr_body_clean" \
      | grep -iE "(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]]+#${_issue_num}([^0-9]|\$)" || true)
    if [[ -n "$_stray" ]]; then
      echo "⚠ #${_issue_num} is still closed by prose left in the PR body — edit it by hand:"
      printf '%s\n' "$_stray" | sed 's/^/    /'
    fi
  fi

  # Rendered once: "#9 #12 #31", no trailing blank. Empty once the last issue is
  # removed — every consumer below has to cope with that.
  if [[ -n "$_all_nums" ]]; then
    _nums_pretty=$(echo "$_all_nums" | sed 's/^/#/' | tr '\n' ' ' | sed 's/ *$//')
  else
    _nums_pretty=""
  fi

  # Pull each linked issue's thread so the regenerated title and body describe
  # what the PR is actually for, not just what the commits happened to touch.
  if [[ -n "$_nums_pretty" ]]; then
    echo "→ Fetching context for issue(s): $_nums_pretty"
  else
    echo "→ No issues left linked — title and body fall back to the commit list."
  fi
  _issues_ctx=""
  for _n in $_all_nums; do
    _one=$(gh issue view "$_n" --repo "$_issue_repo" --json title,body \
      --jq '"\(.title)\n\(.body // "")"' 2>/dev/null || true)
    if [[ -n "$_one" ]]; then
      # Cap each thread — a long issue body starves the model's context window.
      _one=$(printf '%s' "$_one" | head -c 2000)
      _issues_ctx="${_issues_ctx}### Issue #${_n}
${_one}

"
    fi
  done

  _new_title="$_pr_cur_title"
  _new_body="$_pr_body_clean"
  _rewrote=false

  # Rewriting replaces a possibly hand-written title and body, so it never runs
  # unattended: with no TTY to confirm at, only the closing block is updated.
  # --dry-run is exempt — it writes nothing either way.
  if [[ ! -t 0 && "$_issue_dry_run" != "true" ]]; then
    echo "Not a TTY — updating the closing block only, leaving the title and body alone."
  elif _gai_ollama_up; then
    # Attaching the issue is the job; rewriting the title and body is a bonus.
    # One budget covers BOTH generations, so `gai issue` never stalls longer than
    # the user was told to expect — on a box with no spare GPU or RAM a 1.5b
    # model can grind for minutes.
    _budget="${GAI_ISSUE_TIMEOUT:-15}"
    _deadline=$(( $(date +%s) + _budget ))
    _gen_title=""
    _gen_body=""
    _slow=false

    echo "→ Regenerating PR title… (${_budget}s budget for title + body)"
    GAI_GEN_TIMEOUT="$_budget"
    if ! _gen_title=$(_gai_gen_pr_title "$_pr_head" "$_pr_commits" "$_issues_ctx"); then
      _slow=true
    fi

    # The title is the cheaper prompt: if it did not land, the body has no chance
    # in whatever is left, so skip it rather than burning the rest of the budget.
    if [[ "$_slow" != "true" && -n "$_gen_title" ]]; then
      GAI_GEN_TIMEOUT=$(( _deadline - $(date +%s) ))
      if [[ "$GAI_GEN_TIMEOUT" -lt 1 ]]; then
        _slow=true
      else
        echo "→ Regenerating PR body… (${GAI_GEN_TIMEOUT}s left)"
        if ! _gen_body=$(_gai_gen_pr_body "$_pr_head" "$_pr_commits" "" "$_issues_ctx"); then
          _slow=true
        fi
      fi
    fi
    GAI_GEN_TIMEOUT=""

    if [[ "$_slow" == "true" ]]; then
      echo "⚠ Model did not finish inside ${_budget}s — attaching the issue only,"
      echo "  title and body left as they are. Raise it with GAI_ISSUE_TIMEOUT=60."
    elif [[ -z "$_gen_title" || -z "$_gen_body" ]]; then
      echo "⚠ Model returned nothing usable — attaching the issue only,"
      echo "  title and body left as they are."
    else
      # All or nothing: a fresh title above a stale body describes neither.
      _new_title="$_gen_title"
      # A 1.5b model will emit closing lines however firmly the prompt forbids
      # it; the post-filter is what actually keeps the closing block canonical.
      _new_body=$(printf '%s\n' "$_gen_body" \
        | grep -viE "^[[:space:]]*${_close_re}[[:space:]]*$" \
        | python3 -c "import sys; print(sys.stdin.read().rstrip())" || true)
      _rewrote=true
    fi
  else
    echo "⚠ Ollama not running — keeping the existing title and body."
    echo "  Start it (ollama serve) and re-run to regenerate them."
  fi

  # Canonical closing block, rebuilt from scratch every run so re-running with a
  # second issue keeps the first one's Closes line alongside the new one.
  # Removing the last issue leaves nothing to close: ship a bare body rather
  # than a dangling marker over an empty block.
  if [[ -n "$_all_nums" ]]; then
    _closes_block="<!-- gai:closes -->"
    for _n in $_all_nums; do
      _closes_block="${_closes_block}
Closes #${_n}"
    done

    _final_body="${_new_body}

${_closes_block}"
  else
    _final_body="$_new_body"
  fi

  if [[ "$_issue_dry_run" == "true" ]]; then
    echo ""
    echo "── dry run: PR #${_pr_num} would become ──"
    echo "Title: $_new_title"
    echo ""
    echo "$_final_body"
    echo "─────────────────────────────────────────"
  else
    if [[ -t 0 ]]; then
      echo ""
      echo "PR #${_pr_num} new title: $_new_title"
      if [[ -n "$_nums_pretty" ]]; then
        echo "Closes: $_nums_pretty"
      else
        echo "Closes: (none)"
      fi
      read -rp "Apply this title and body to PR #${_pr_num}? [Y/n] " _apply || true
      case "$_apply" in
        [Nn]*)
          echo "Skipped — PR #${_pr_num} left unchanged."
          _gai_issue_claude_session
          exit 0
          ;;
      esac
    fi

    gh pr edit "$_pr_num" --repo "$_issue_repo" \
      --title "$_new_title" \
      --body "$_final_body"
    if [[ "$_issue_remove" == "true" ]]; then
      _left="${_nums_pretty:-none}"
      if [[ "$_rewrote" == "true" ]]; then
        echo "✓ Updated PR #${_pr_num} — removed #${_issue_num}, rewrote title and body, still closes: $_left"
      else
        echo "✓ Updated PR #${_pr_num} — removed #${_issue_num}, still closes: $_left (title and body unchanged)"
      fi
    elif [[ "$_rewrote" == "true" ]]; then
      echo "✓ Updated PR #${_pr_num} — title, body, and Closes for $_nums_pretty"
    else
      echo "✓ Updated PR #${_pr_num} — Closes for $_nums_pretty (title and body unchanged)"
    fi
  fi

  _gai_issue_claude_session
  exit 0
fi

# ── flag parsing ──────────────────────────────────────────────────────────────

for arg in "$@"; do
  case "$arg" in
    --dry-run|-n) DRY_RUN=true ;;
    --all)        MODE="all" ;;
    --force|-f)   FORCE=true ;;
    --version|-v)
      echo "gai v$(cat "$HOME/.gai/version" 2>/dev/null || echo "unknown")"
      exit 0
      ;;
    --logs)
      _prune_logs
      _lf=()
      while IFS= read -r f; do
        [[ -n "$f" ]] && _lf+=("$f")
      done < <(find "$LOG_DIR" -name "*.log" -mmin -1440 2>/dev/null | sort)
      if [[ ${#_lf[@]} -eq 0 ]]; then
        echo "No gai activity in the last 24 h."
      else
        cat "${_lf[@]}"
      fi
      exit 0
      ;;
    update)
      echo "→ Updating gai-tools from GitHub…"
      _old_ver=$(cat "$HOME/.gai/version" 2>/dev/null || echo "unknown")
      TMP=$(mktemp -d)
      _release_json=$(curl -fsSL https://api.github.com/repos/Navibyte-Innovations-Pvt-Ltd/gai-tools/releases/latest)
      _new_ver=$(echo "$_release_json" | python3 -c "import sys,json; print(json.load(sys.stdin).get('tag_name','').lstrip('v'))" 2>/dev/null || echo "")
      TARBALL=$(echo "$_release_json" | python3 -c "import sys,json; assets=json.load(sys.stdin)['assets']; print(next(a['name'] for a in assets if a['name'].endswith('.tar.gz')))")
      curl -fsSL "https://github.com/Navibyte-Innovations-Pvt-Ltd/gai-tools/releases/latest/download/${TARBALL}" \
        | tar -xz -C "$TMP"
      bash "$TMP/install.sh"
      rm -rf "$TMP"
      if [[ -n "$_new_ver" && "$_old_ver" != "$_new_ver" ]]; then
        echo "✓ gai-tools updated  v${_old_ver} → v${_new_ver}"
      else
        echo "✓ gai-tools updated  v${_new_ver} (already latest)"
      fi
      exit 0
      ;;
    pr)
      _gai_pr=true
      ;;
    pause)
      mkdir -p "$HOME/.gai"
      touch "$HOME/.gai/paused"
      echo "⏸  Auto-commit paused. 'gai pr' and 'gai issue' still work."
      echo "   Resume with: gai resume"
      exit 0
      ;;
    resume)
      rm -f "$HOME/.gai/paused"
      echo "▶  Auto-commit resumed."
      exit 0
      ;;
    remove|uninstall)
      echo "This will remove gai/gai-watch, stop all watchers, and remove the ~/.zshrc hook."
      read -rp "Continue? [y/N] " _confirm || true
      if [[ "$_confirm" != "y" && "$_confirm" != "Y" ]]; then
        echo "Aborted."
        exit 0
      fi

      pkill -f gai-watch 2>/dev/null || true
      rm -f /tmp/gai-watch-*.pid

      if grep -q "gai-tools:" "$HOME/.zshrc" 2>/dev/null; then
        sed -i '' '/# gai-tools: auto-start/,/# end gai-tools/d' "$HOME/.zshrc"
        echo "✓ Removed hook from ~/.zshrc"
      fi

      rm -f "$HOME/.local/bin/gai" "$HOME/.local/bin/gai-watch"
      echo "✓ Removed gai and gai-watch from ~/.local/bin"

      echo ""
      echo "gai-tools uninstalled. Ollama and fswatch were left in place."
      echo "  To remove them: brew uninstall ollama fswatch"
      echo "  Reload shell: source ~/.zshrc"
      exit 0
      ;;
    --help|-h)
      echo "Usage: gai [--all] [--dry-run] [--force] [--version] [--logs] [update] [pr] [issue <n|url>] [pause] [resume] [remove]"
      echo "  Default      : commit staged files one by one (AI message per file)"
      echo "  --all        : commit all dirty files instead of staged"
      echo "  --dry-run    : show messages without committing"
      echo "  --force      : commit even if a file trips the secret check"
      echo "  --version    : print installed gai-tools version"
      echo "  --logs       : show last 24 h of activity (\$GAI_LOG_DIR)"
      echo "  update       : pull latest version from GitHub"
      echo "  pr           : create a GitHub PR from current branch (requires gh CLI)."
      echo "                 On main/master it offers to cut a branch first (default: dev)."
      echo "  issue <n|url>: attach a GitHub issue to an open PR (creates one if none open),"
      echo "                 rewrite the PR title and body from the issue thread, keep every"
      echo "                 previous 'Closes #N' and add the new one, then offer a Claude"
      echo "                 session seeded with the full issue thread."
      echo "                 A bare number resolves against the repo you are standing in."
      echo "                 --remove (-r) detaches instead: drops that issue's 'Closes #N',"
      echo "                 keeps the rest, and rewrites the title and body from what is left."
      echo "  pause        : stop auto-commit (gai pr / gai issue keep working)"
      echo "  resume       : re-enable auto-commit after 'gai pause'"
      echo "  remove       : uninstall gai/gai-watch (alias: uninstall)"
      echo ""
      echo "Model: \$GAI_MODEL (default: $MODEL)"
      echo "Secret allowlist: \$GAI_ALLOW_PATHS (colon-separated globs) or 'allow=<glob>' lines in <repo>/.gairc"
      echo "Requires: ollama running + model pulled"
      echo "  brew install ollama && ollama pull $MODEL"
      exit 0
      ;;
  esac
done

# ── pr subcommand ─────────────────────────────────────────────────────────────

if [[ "${_gai_pr:-false}" == "true" ]]; then
  if ! git rev-parse --git-dir > /dev/null 2>&1; then
    echo "error: not inside a git repository" >&2
    exit 1
  fi

  if ! command -v gh > /dev/null 2>&1; then
    echo "error: gh CLI not installed." >&2
    echo "  Install: brew install gh && gh auth login" >&2
    exit 1
  fi

  if ! gh auth status > /dev/null 2>&1; then
    echo "error: gh CLI not authenticated." >&2
    echo "  Run: gh auth login" >&2
    exit 1
  fi

  CURRENT_BRANCH=$(git branch --show-current)
  BASE_BRANCH=$(gh repo view --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || echo "main")

  # A PR cannot be opened from the base branch. Rather than dead-ending here,
  # offer to cut the feature branch the user was going to create anyway.
  if [[ "$CURRENT_BRANCH" == "$BASE_BRANCH" || "$CURRENT_BRANCH" == "main" || "$CURRENT_BRANCH" == "master" ]]; then
    if [[ ! -t 0 ]]; then
      echo "error: on branch '$CURRENT_BRANCH' — switch to a feature branch first." >&2
      exit 1
    fi

    echo "On '$CURRENT_BRANCH' — a PR needs a feature branch."
    read -rp "Branch name [dev] (n to abort): " _new_branch || true
    _new_branch="${_new_branch:-dev}"

    case "$_new_branch" in
      [Nn]|[Nn][Oo])
        echo "Aborted — still on '$CURRENT_BRANCH'." >&2
        exit 1
        ;;
    esac

    if [[ "$_new_branch" == "$BASE_BRANCH" || "$_new_branch" == "main" || "$_new_branch" == "master" ]]; then
      echo "error: '$_new_branch' is a base branch — pick another name." >&2
      exit 1
    fi

    if git show-ref --verify --quiet "refs/heads/$_new_branch"; then
      echo "→ Branch '$_new_branch' already exists — switching to it."
      git checkout "$_new_branch"
    else
      echo "→ Creating branch '$_new_branch'…"
      git checkout -b "$_new_branch"
    fi

    CURRENT_BRANCH=$(git branch --show-current)
  fi

  git fetch origin "$BASE_BRANCH" --quiet 2>/dev/null || true
  PR_COMMITS=$(git log "origin/$BASE_BRANCH"..HEAD --oneline 2>/dev/null)
  if [[ -z "$PR_COMMITS" ]]; then
    echo "No commits ahead of 'origin/$BASE_BRANCH' — nothing to diff." >&2
    read -rp "Create an empty commit to open the PR anyway (e.g. for issue tracking)? [Y/n] " _empty_confirm || true
    case "$_empty_confirm" in
      [Nn]*)
        echo "Aborted." >&2
        exit 1
        ;;
    esac
    git commit --allow-empty -m "chore($CURRENT_BRANCH): open PR for issue tracking"
    PR_COMMITS=$(git log "origin/$BASE_BRANCH"..HEAD --oneline 2>/dev/null)
  fi

  if ! curl -s --connect-timeout 2 "http://localhost:11434" > /dev/null 2>&1; then
    echo "error: Ollama not running." >&2
    echo "  Start:   ollama serve" >&2
    echo "  Install: brew install ollama && ollama pull $MODEL" >&2
    exit 1
  fi

  PR_DIFF_STAT=$(git diff --no-ext-diff "origin/$BASE_BRANCH"...HEAD --stat 2>/dev/null)

  echo "→ Generating PR title…"
  PR_TITLE=$(_gai_gen_pr_title "$CURRENT_BRANCH" "$PR_COMMITS") || true

  if [[ -z "$PR_TITLE" ]]; then
    PR_TITLE="feat(${CURRENT_BRANCH}): changes from branch"
  fi

  echo "→ Generating PR body…"
  PR_BODY=$(_gai_gen_pr_body "$CURRENT_BRANCH" "$PR_COMMITS" "$PR_DIFF_STAT") || true

  if [[ -z "$PR_BODY" ]]; then
    _pr_bullets=""
    while IFS= read -r _line; do
      _pr_bullets+="- ${_line}"$'\n'
    done <<< "$PR_COMMITS"
    PR_BODY="## What and why
${_pr_bullets}
## Changes
$PR_DIFF_STAT"
  fi

  echo "→ Pushing branch '$CURRENT_BRANCH'…"
  git push -u origin "$CURRENT_BRANCH"

  echo "→ Creating PR…"
  # A PR may already exist for this branch (common when re-running after
  # 'gai issue'); surface its URL instead of failing.
  if ! PR_URL=$(gh pr create \
    --base "$BASE_BRANCH" \
    --assignee @me \
    --title "$PR_TITLE" \
    --body "$PR_BODY"); then
    PR_URL=$(gh pr view --json url --jq '.url' 2>/dev/null || true)
    if [[ -z "$PR_URL" ]]; then
      echo "error: PR creation failed." >&2
      exit 1
    fi
    echo "→ A PR already exists for '$CURRENT_BRANCH' — reusing it."
  fi

  echo ""
  echo "✓ PR created: $PR_URL"
  echo "  Branch: $CURRENT_BRANCH → $BASE_BRANCH"
  echo "  Title:  $PR_TITLE"
  exit 0
fi

# ── paused check ─────────────────────────────────────────────────────────────

if [[ -f "$HOME/.gai/paused" ]]; then
  echo "⏸  Auto-commit paused (gai pause). Run 'gai resume' to re-enable." >&2
  exit 0
fi

# ── logging setup ────────────────────────────────────────────────────────────

_prune_logs
LOG_FILE="$LOG_DIR/$(date +%Y-%m-%d).log"
exec > >(tee -a "$LOG_FILE") 2>&1
echo "── gai $(date '+%Y-%m-%d %H:%M:%S') ──────────────────────────────────────────"

# ── sanity checks ────────────────────────────────────────────────────────────

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "error: not inside a git repository" >&2
  exit 1
fi

GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)

# Every path we handle from here on is repo-root-relative (that is what
# `git diff --name-only` emits, and what allowlist globs are written against),
# so run from the root. Called from a subdirectory those paths resolved against
# the wrong base and nothing committed at all.
GIT_TOPLEVEL=$(git rev-parse --show-toplevel 2>/dev/null || true)
if [[ -n "$GIT_TOPLEVEL" ]]; then
  cd "$GIT_TOPLEVEL" || exit 1
fi

if [[ -f "$GIT_DIR/MERGE_HEAD" ]] || git status --short | grep -qE '^(UU|AA|DD|AU|UA|UD|DU) '; then
  echo "⏸  Merge in progress with unresolved conflicts — refusing to auto-commit." >&2
  echo "   Resolve conflicts, 'git add' the files, then commit manually." >&2
  exit 0
fi

if ! curl -s --connect-timeout 2 "http://localhost:11434" > /dev/null 2>&1; then
  echo "error: Ollama not running." >&2
  echo "  Start:   ollama serve" >&2
  echo "  Install: brew install ollama && ollama pull $MODEL" >&2
  exit 1
fi

# ── ensure gai-watch is running in this repo ─────────────────────────────────

_ensure_watch() {
  local repo repo_hash pidfile pid
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  repo_hash=$(echo "$repo" | md5)
  pidfile="/tmp/gai-watch-${repo_hash}.pid"
  if [[ -f "$pidfile" ]]; then
    pid=$(awk '{print $1}' "$pidfile" 2>/dev/null)
    # `kill -0` alone trusts a recycled PID: once some unrelated process inherits
    # that number the watcher looks alive forever and is never restarted. Confirm
    # the process really is a gai-watch before believing the file.
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null &&
       ps -p "$pid" -o command= 2>/dev/null | grep -q "gai-watch"; then
      return 0
    fi
    echo "→ stale gai-watch pidfile (pid ${pid:-?} not running) — restarting watcher"
    rm -f "$pidfile"
  fi
  gai-watch > "/tmp/gai-watch-${repo_hash}.log" 2>&1 &
  disown $! 2>/dev/null || true
  echo "$! $repo" > "$pidfile"
}

_ensure_watch

# ── per-repo lock (prevent concurrent gai runs racing on .git/index.lock) ─────
# macOS has no flock; use an atomic mkdir mutex with stale-lock reclaim.

GAI_LOCK_DIR=""

_release_lock() {
  if [[ -n "$GAI_LOCK_DIR" ]]; then
    rm -rf "$GAI_LOCK_DIR" 2>/dev/null || true
  fi
}

_acquire_lock() {
  local repo repo_hash
  repo=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  repo_hash=$(echo "$repo" | md5)
  GAI_LOCK_DIR="/tmp/gai-run-${repo_hash}.lock"

  if mkdir "$GAI_LOCK_DIR" 2>/dev/null; then
    echo $$ > "$GAI_LOCK_DIR/pid"
    trap _release_lock EXIT INT TERM
    return 0
  fi

  # Lock exists — reclaim only if the owning process is dead.
  local owner
  owner=$(cat "$GAI_LOCK_DIR/pid" 2>/dev/null || true)
  if [[ -n "$owner" ]] && kill -0 "$owner" 2>/dev/null; then
    echo "Another gai is already running for this repo (pid $owner) — skipping."
    GAI_LOCK_DIR=""
    exit 0
  fi

  rm -rf "$GAI_LOCK_DIR" 2>/dev/null || true
  if mkdir "$GAI_LOCK_DIR" 2>/dev/null; then
    echo $$ > "$GAI_LOCK_DIR/pid"
    trap _release_lock EXIT INT TERM
    return 0
  fi

  echo "Could not acquire gai lock for this repo — skipping."
  GAI_LOCK_DIR=""
  exit 0
}

_acquire_lock

# ── helpers ──────────────────────────────────────────────────────────────────

# ── secret detection ─────────────────────────────────────────────────────────
# Two independent gates, both narrow on purpose:
#   1. filename  — only names that ARE a secret store (.env, *.pem, id_rsa …).
#      Directory names never count: `app/api/client-credentials/route.ts` is
#      ordinary source, and matching the whole path made gai unusable there.
#   2. content   — high-confidence vendor key prefixes in the ADDED lines. This
#      is what actually stops a leak; a path never could.
# Both are overridable via GAI_ALLOW_PATHS, .gairc, or --force.

_SECRET_REASON=""

# Repo-relative globs that are never flagged. Sources, in order:
#   GAI_ALLOW_PATHS  colon-separated globs
#   <repo>/.gairc    `allow=<glob>` lines (read line by line — NEVER sourced,
#                    this runs unattended from gai-watch)
_ALLOW_GLOBS=()
_ALLOW_LOADED=false

_load_allow_globs() {
  $_ALLOW_LOADED && return 0
  _ALLOW_LOADED=true

  local _ifs_save="$IFS" g root line
  IFS=':'
  for g in ${GAI_ALLOW_PATHS:-}; do
    [[ -n "$g" ]] && _ALLOW_GLOBS+=("$g")
  done
  IFS="$_ifs_save"

  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  [[ -z "$root" || ! -f "$root/.gairc" ]] && return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    case "$line" in
      allow=*) _ALLOW_GLOBS+=("${line#allow=}") ;;
    esac
  done < "$root/.gairc"
}

_path_allowed() {
  local f="$1" g
  _load_allow_globs
  for g in ${_ALLOW_GLOBS+"${_ALLOW_GLOBS[@]}"}; do
    # shellcheck disable=SC2053  # glob match is the point
    [[ "$f" == $g ]] && return 0
  done
  return 1
}

# Flag ONLY on the basename. Sets _SECRET_REASON when it returns 0.
is_secret() {
  local f="$1" base
  _SECRET_REASON=""
  $FORCE && return 1
  _path_allowed "$f" && return 1

  base="${f##*/}"

  # Committed on purpose — templates carry placeholders, not values. Their
  # added lines still go through the content scan below.
  case "$base" in
    .env.example|.env.sample|.env.template|*.env.example|*.env.sample|*.env.template)
      return 1 ;;
  esac

  case "$base" in
    .env|.env.*|*.env)
      _SECRET_REASON="filename '$base' is an environment file" ;;
    id_rsa|id_dsa|id_ecdsa|id_ed25519|*.pem|*.key|*.p8|*.p12|*.pfx|*.jks|*.keystore|*.asc|*.gpg)
      _SECRET_REASON="filename '$base' looks like a private key or keystore" ;;
    credentials|credentials.json|credentials.yml|credentials.yaml|secrets.json|secrets.yml|secrets.yaml|*.secret|.netrc|.pgpass|.htpasswd|service-account*.json)
      _SECRET_REASON="filename '$base' is a known credential store" ;;
  esac

  [[ -n "$_SECRET_REASON" ]]
}

# Scan the ADDED lines of a file's diff for real key material. Only prefixes issued by
# a known provider block a commit — no entropy heuristics, no `password = "…"`
# guessing. A fuzzy rule here would recreate the exact false-positive problem
# this replaced, one layer down.
scan_diff_secrets() {
  local file="$1" diff="$2" added hit
  _SECRET_REASON=""
  $FORCE && return 1
  _path_allowed "$file" && return 1

  added=$(printf '%s\n' "$diff" | grep '^+' | grep -v '^+++' || true)
  [[ -z "$added" ]] && return 1

  hit=$(printf '%s\n' "$added" | grep -oE \
    -e '-----BEGIN [A-Z ]*PRIVATE KEY-----' \
    -e 'AKIA[0-9A-Z]{16}' \
    -e 'ASIA[0-9A-Z]{16}' \
    -e 'sk-[A-Za-z0-9_-]{24,}' \
    -e 'sk-ant-[A-Za-z0-9_-]{24,}' \
    -e 'ghp_[A-Za-z0-9]{36}' \
    -e 'gho_[A-Za-z0-9]{36}' \
    -e 'github_pat_[A-Za-z0-9_]{40,}' \
    -e 'xox[baprs]-[A-Za-z0-9-]{12,}' \
    -e 'AIza[0-9A-Za-z_-]{35}' \
    -e 'glpat-[A-Za-z0-9_-]{20,}' \
    -e 'npm_[A-Za-z0-9]{36}' \
    -e 'pypi-[A-Za-z0-9_-]{32,}' \
    -e 'AC[0-9a-f]{32}' \
    2>/dev/null | head -1 || true)

  [[ -z "$hit" ]] && return 1
  _SECRET_REASON="added line contains '${hit:0:12}…' — looks like a live credential"
  return 0
}

_secret_skip() {
  local file="$1"
  echo "  ⚠ skip (secret): $file"
  echo "      why: ${_SECRET_REASON}"
  echo "      commit anyway: gai --force   |   always allow: echo 'allow=$file' >> .gairc"
}

# Deterministic short scope derived from a file path — used both as a prompt
# hint (small models copy raw paths verbatim if asked to "derive" one) and as
# a fallback when the model's own scope is unusable (contains "/", too long).
_short_scope() {
  local file="$1" base dir
  base=$(basename "$file")
  base="${base%.*}"
  case "$base" in
    index|route|page|actions|action|schema|schemas|types|utils|hooks|constants|config|page.tsx)
      dir=$(dirname "$file")
      base=$(basename "$dir")
      ;;
  esac
  base=$(echo "$base" | sed -E 's/\[[^]]*\]//g')
  base=$(echo "$base" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g' | sed -E 's/^-+|-+$//g')
  [[ -z "$base" ]] && base="repo"
  echo "$base"
}

gen_message() {
  local file="$1" diff="$2"
  local suggested_scope
  suggested_scope=$(_short_scope "$file")
  local prompt="Write a git commit message in conventional commit format for this diff.
Reply with ONLY the commit message on one line. No explanation. No backticks. No quotes.

Format: type(scope): short description
Rules:
- type: feat fix refactor style docs test chore perf
- scope: ONE short word or hyphenated component name, 1-3 words, NO slashes, NO file extensions, NOT the raw file path. Suggested scope for this file: $suggested_scope — use it unless a shorter/more accurate component name is obvious from the diff.
- description: imperative mood, max 72 chars, describe the ACTUAL change in THIS diff — never a generic phrase like \"update logic\" or \"update index watching logic\"
- describe WHY the change was needed or what problem it solves, not just what file changed
- example of the format only (do not reuse this wording): \"fix(auth): stop clearing session on token refresh\"

File: $file
Diff:
$diff"

  local escaped
  escaped=$(python3 -c "import sys,json; print(json.dumps(sys.stdin.read()))" <<< "$prompt")

  local response
  response=$(curl -s --connect-timeout 10 "$OLLAMA_URL" \
    -H "Content-Type: application/json" \
    -d "{\"model\":\"$MODEL\",\"prompt\":$escaped,\"stream\":false}")

  local msg
  msg=$(python3 -c "
import sys, json
try:
  d = json.load(sys.stdin)
  msg = d.get('response', '').strip()
  lines = [l.strip() for l in msg.splitlines() if l.strip()]
  print(lines[0] if lines else '')
except Exception:
  pass
" <<< "$response" || true)

  _sanitize_message "$msg" "$file" "$suggested_scope"
}

# Guards against two small-model failure modes seen in practice:
#  1. scope echoes the raw file path instead of a short component name
#  2. on a low-signal diff (e.g. a one-line config bump) the model parrots
#     boilerplate like "update index watching logic" instead of describing
#     the actual change
_sanitize_message() {
  local msg="$1" file="$2" fallback_scope="$3"

  if [[ -z "$msg" ]]; then
    echo ""
    return
  fi

  local re='^([a-z]+)\((.*)\):[[:space:]]*(.*)$'
  if [[ "$msg" =~ $re ]]; then
    local type="${BASH_REMATCH[1]}" scope="${BASH_REMATCH[2]}" desc="${BASH_REMATCH[3]}"

    if [[ "$scope" == *"/"* || ${#scope} -gt 24 ]]; then
      scope="$fallback_scope"
    fi

    case "$desc" in
      *"index watching logic"*|*"update logic"*|"update index watching"*)
        desc="update $(basename "$file")"
        ;;
    esac

    echo "${type}(${scope}): ${desc}"
  else
    echo "$msg"
  fi
}

commit_file() {
  local file="$1"

  # Name check runs BEFORE `git add` so a real secret is never staged by us.
  if is_secret "$file"; then
    _secret_skip "$file"
    return 1
  fi

  echo ""
  echo "── $file"

  # Normalise the index for THIS file only, so the diff we describe is the
  # content we are about to commit. Other files keep their staged state.
  git add -- "$file" > /dev/null 2>&1 || true

  local diff
  diff=$(git diff --no-ext-diff --cached -- "$file")
  if [[ -z "$diff" ]]; then
    echo "  (empty staged diff — skipping)"
    return 1
  fi

  # Content check — the added lines are the only place a leak can actually be.
  if scan_diff_secrets "$file" "$diff"; then
    _secret_skip "$file"
    return 1
  fi

  local msg
  msg=$(gen_message "$file" "$diff")
  if [[ -z "$msg" ]]; then
    echo "  ✗ model returned empty message — skipping"
    return 1
  fi

  echo "  → $msg"

  if $DRY_RUN; then
    echo "  (dry-run)"
  else
    # Pathspec-limited commit — records ONLY this file. A bare `git commit -m`
    # here sweeps in anything another process staged while the model was
    # generating the message, filing it under the wrong message entirely.
    if ! git commit --no-verify -m "$msg" -- "$file"; then
      echo "  ✗ commit failed — leaving $file staged"
      return 1
    fi
  fi
  return 0
}

# Newline-delimited set of paths this run has already handled, so the adopt pass
# below never re-queues a file that was skipped (secret, empty diff, failed
# commit) — those stay staged on purpose and would otherwise loop forever.
SEEN=$'\n'

_seen() {
  case "$SEEN" in
    *$'\n'"$1"$'\n'*) return 0 ;;
  esac
  return 1
}

_mark_seen() { SEEN="${SEEN}${1}"$'\n'; }

# ── staged mode (default) ────────────────────────────────────────────────────

if [[ "$MODE" == "staged" ]]; then
  QUEUE=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && QUEUE+=("$line")
  done < <(git diff --cached --name-only)

  if [[ ${#QUEUE[@]} -eq 0 ]]; then
    echo "No staged files. Stage files with 'git add', or use --all for all dirty files."
    exit 0
  fi

  echo "Staged: ${#QUEUE[@]} file(s) → committing one by one…"

  # There is deliberately NO global `git reset` here. Every commit is
  # pathspec-limited, so files further down the queue keep their staged state
  # until their turn. If this run dies early, whatever it did not reach is still
  # staged — not silently unstaged and forgotten.

  COMMITTED=0 SKIPPED=()
  MAX_PASSES=5
  PASS=1
  while :; do
    for FILE in "${QUEUE[@]}"; do
      _seen "$FILE" && continue
      _mark_seen "$FILE"
      if commit_file "$FILE"; then
        COMMITTED=$((COMMITTED + 1))
      else
        SKIPPED+=("$FILE")
      fi
    done

    # Adopt whatever was staged while this run was busy. gai-watch's triggers for
    # those files were dropped by the per-repo lock, so the finishing run is the
    # only thing that knows the queue is not empty.
    QUEUE=()
    while IFS= read -r line; do
      [[ -z "$line" ]] && continue
      _seen "$line" && continue
      QUEUE+=("$line")
    done < <(git diff --cached --name-only)

    [[ ${#QUEUE[@]} -eq 0 ]] && break

    PASS=$((PASS + 1))
    if [[ $PASS -gt $MAX_PASSES ]]; then
      echo ""
      echo "⚠ Stopped after $MAX_PASSES passes — ${#QUEUE[@]} file(s) staged during the last pass are left for the next run:"
      for f in "${QUEUE[@]}"; do echo "  - $f"; done
      break
    fi

    echo ""
    echo "→ ${#QUEUE[@]} more file(s) staged during this run — pass ${PASS}…"
  done

# ── all mode ─────────────────────────────────────────────────────────────────

else
  FILES=()
  while IFS= read -r line; do
    local_file=$(echo "$line" | awk '{print $2}')
    [[ -n "$local_file" ]] && FILES+=("$local_file")
  done < <(git -c status.relativePaths=false status --short)

  if [[ ${#FILES[@]} -eq 0 ]]; then
    echo "Working tree is clean. Nothing to commit."
    exit 0
  fi

  echo "Dirty: ${#FILES[@]} file(s) → committing one by one…"

  COMMITTED=0 SKIPPED=()
  for FILE in "${FILES[@]}"; do
    local_status=$(git -c status.relativePaths=false status --short -- "$FILE" | awk '{print $1}')
    local_diff=""
    if [[ "$local_status" == "??" ]]; then
      local_diff=$(git diff --no-ext-diff --no-index /dev/null "$FILE" 2>/dev/null || true)
    else
      local_diff=$(git diff --no-ext-diff -- "$FILE")
    fi
    [[ -z "$local_diff" ]] && continue

    if commit_file "$FILE"; then
      COMMITTED=$((COMMITTED + 1))
    else
      git reset HEAD -- "$FILE" > /dev/null 2>&1 || true
      SKIPPED+=("$FILE")
    fi
  done
fi

# ── summary ──────────────────────────────────────────────────────────────────

echo ""
echo "Committed: $COMMITTED file(s)."
if [[ ${#SKIPPED[@]} -gt 0 ]]; then
  echo "Skipped (${#SKIPPED[@]}):"
  for f in "${SKIPPED[@]}"; do echo "  - $f"; done
fi

# Never finish quietly on a partial job. Silence after a 40-file batch is what
# made this dangerous — the batch looked finished while files sat uncommitted.
LEFTOVER=()
while IFS= read -r line; do
  [[ -n "$line" ]] && LEFTOVER+=("$line")
done < <(git diff --cached --name-only 2>/dev/null)

if [[ ${#LEFTOVER[@]} -gt 0 ]] && ! $DRY_RUN; then
  echo "⚠ ${#LEFTOVER[@]} file(s) still staged and uncommitted:"
  for f in "${LEFTOVER[@]}"; do echo "  - $f"; done
fi
