#!/usr/bin/env bash
# gai-watch — auto-run gai whenever files are staged in this git repo or its submodules
# Usage: gai-watch [--dry-run]
#   Run once per repo in a terminal tab. Stage files in VS Code → auto-commits.

set -euo pipefail

LOG_DIR="${GAI_LOG_DIR:-$HOME/.gai/logs}"

_prune_watch_logs() {
  mkdir -p "$LOG_DIR"
  find "$LOG_DIR" -name "*.watch.log" -mmin +1440 -delete 2>/dev/null || true
}

EXTRA_ARGS=()
for arg in "$@"; do
  case "$arg" in
    --dry-run|-n) EXTRA_ARGS+=(--dry-run) ;;
    --help|-h)
      echo "Usage: gai-watch [--dry-run]"
      echo "  Watches .git/index and auto-runs gai when files are staged."
      echo "  Also watches submodule indices if submodules are present."
      echo "  Run once in a terminal tab. Stage files in VS Code → they commit."
      echo "  Logs saved to \$GAI_LOG_DIR (default: ~/.gai/logs) for 24 h."
      exit 0
      ;;
  esac
done

if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "error: not inside a git repository" >&2
  exit 1
fi

GIT_DIR=$(git rev-parse --git-dir)
[[ "$GIT_DIR" != /* ]] && GIT_DIR="$PWD/$GIT_DIR"
REPO_ROOT=$(git rev-parse --show-toplevel)
REPO_HASH=$(echo "$REPO_ROOT" | md5)
PID_FILE="/tmp/gai-watch-${REPO_HASH}.pid"
# Touched on every shell visit (.zshrc hook) and every index change; its age is
# what the idle stop below measures.
SEEN_FILE="/tmp/gai-watch-seen-${REPO_HASH}"
WATCH_CONF="$HOME/.gai/watch"

# Lines of `key=value` from a file, comments and blanks dropped. Read line by
# line — NEVER sourced, same as .gairc in gai.
_conf_lines() {
  local key="$1" file="$2" line
  [[ -f "$file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    case "$line" in
      "$key="*) echo "${line#"$key="}" ;;
    esac
  done < "$file"
}

# Does $REPO_ROOT match any glob read from stdin? A leading ~/ means $HOME.
_repo_matches() {
  local g
  while IFS= read -r g; do
    [[ -z "$g" ]] && continue
    # shellcheck disable=SC2088 # a literal ~/ in the config, expanded by hand
    if [[ "${g:0:2}" == '~/' ]]; then
      g="$HOME/${g:2}"
    fi
    # shellcheck disable=SC2053
    if [[ "$REPO_ROOT" == $g || "$REPO_ROOT" == "${g%/}" ]]; then
      return 0
    fi
  done
  return 1
}

# Why this repo must not be watched, or nothing. The .zshrc hook starts a watcher
# in every repo a shell enters (issue #56): CI runner checkouts that CI owns,
# throwaway temp clones and worktrees all piled up, and fseventsd with them.
_skip_reason() {
  if [[ "${GAI_WATCH_DISABLE:-}" == "1" ]]; then
    echo "GAI_WATCH_DISABLE=1"; return
  fi
  if [[ -n "${CI:-}" || -n "${GITHUB_ACTIONS:-}" ]]; then
    echo "running under CI"; return
  fi
  if [[ "$(_conf_lines watch "$REPO_ROOT/.gairc" | tail -1)" == "off" ]]; then
    echo "watch=off in .gairc"; return
  fi
  if _conf_lines skip "$WATCH_CONF" | _repo_matches; then
    echo "skip= in ~/.gai/watch"; return
  fi
  if [[ -n "$(_conf_lines only "$WATCH_CONF")" ]] && ! _conf_lines only "$WATCH_CONF" | _repo_matches; then
    echo "not under an only= path in ~/.gai/watch"; return
  fi
  # allow= overrides the built-in rules below, nothing above.
  if _conf_lines allow "$WATCH_CONF" | _repo_matches; then
    return
  fi
  case "$REPO_ROOT" in
    */_work/*|*/actions-runner/*|*/github-runners/*)
      echo "CI runner checkout"; return ;;
    /tmp/*|/private/tmp/*|/var/folders/*|/private/var/folders/*)
      echo "temp directory"; return ;;
  esac
  if [[ -n "${RUNNER_WORKSPACE:-}" && "$REPO_ROOT" == "${RUNNER_WORKSPACE%/}"/* ]]; then
    echo "CI runner checkout"; return
  fi
  if [[ -n "${TMPDIR:-}" && "$REPO_ROOT" == "${TMPDIR%/}"/* ]]; then
    echo "temp directory"; return
  fi
  # A worktree's git dir is .git/worktrees/<name>; its common dir is the main
  # .git. Submodules also have a .git *file*, so that alone is not the test.
  local common
  common=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  [[ "$common" != /* ]] && common="$PWD/$common"
  if [[ "$(cd "$GIT_DIR" && pwd -P)" != "$(cd "$common" && pwd -P)" ]]; then
    echo "git worktree"; return
  fi
}

SKIP_REASON=$(_skip_reason)
if [[ -n "$SKIP_REASON" ]]; then
  echo "gai-watch: not watching $REPO_ROOT ($SKIP_REASON)."
  # The hook wrote our PID here when it started us; leave no live-looking entry.
  if [[ "$(awk '{print $1}' "$PID_FILE" 2>/dev/null)" == "$$" ]]; then
    rm -f "$PID_FILE"
  fi
  case "$SKIP_REASON" in
    "CI runner checkout"|"temp directory"|"git worktree")
      echo "  To watch it anyway: echo 'allow=$REPO_ROOT' >> ~/.gai/watch" ;;
  esac
  exit 0
fi

_prune_watch_logs
LOG_FILE="$LOG_DIR/$(date +%Y-%m-%d).watch.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "── gai-watch $(date '+%Y-%m-%d %H:%M:%S') repo:$REPO_ROOT ──"

# Own the PID file. Previously only `gai` and the .zshrc hook wrote it, using the
# background job's $!, so a hand-started watcher left none and got duplicated. A
# stale file also made the auto-start hook believe a dead watcher was alive.
echo "$$ $REPO_ROOT" > "$PID_FILE"

# Never exit quietly: the failure mode in issue #28 was total silence in the log,
# which is why a dead watcher went unnoticed for over an hour.
_on_exit() {
  local code=$?
  echo "$(date '+%H:%M:%S') gai-watch exiting (code $code) repo:$REPO_ROOT"
  if [[ -f "$PID_FILE" ]] && [[ "$(awk '{print $1}' "$PID_FILE" 2>/dev/null)" == "$$" ]]; then
    rm -f "$PID_FILE"
  fi
  if [[ -n "${IDLE_PID:-}" ]]; then
    # Its sleep child first would make the subshell print "Terminated: 15".
    local kids
    kids=$(pgrep -P "$IDLE_PID" 2>/dev/null || true)
    kill "$IDLE_PID" 2>/dev/null || true
    # shellcheck disable=SC2086
    [[ -z "$kids" ]] || kill $kids 2>/dev/null || true
  fi
}
trap _on_exit EXIT

# Shut down the watch pipeline explicitly. Bash defers a trap until the current
# foreground command returns, and the fswatch pipeline never returns — so INT and
# TERM would sit queued forever and the exit line above would never print.
# `wait` below is interruptible, and this tears down fswatch with us.
_shutdown() {
  local code="$1"
  if [[ -n "${PIPELINE_PID:-}" ]]; then
    pkill -P "$PIPELINE_PID" 2>/dev/null || true
    kill "$PIPELINE_PID" 2>/dev/null || true
  fi
  exit "$code"
}
trap '_shutdown 130' INT
trap '_shutdown 143' TERM

touch "$SEEN_FILE" 2>/dev/null || true

# Cap the number of watchers. The hook detaches watchers from the shell, so they
# outlive it; past the cap, stop the ones whose repo was seen least recently.
WATCH_MAX="${GAI_WATCH_MAX:-10}"
if [[ "$WATCH_MAX" =~ ^[0-9]+$ ]] && (( WATCH_MAX > 0 )); then
  _live=()
  for _pf in /tmp/gai-watch-*.pid; do
    [[ -f "$_pf" ]] || continue
    _pid=$(awk '{print $1}' "$_pf" 2>/dev/null)
    [[ -n "$_pid" && "$_pid" != "$$" ]] || continue
    kill -0 "$_pid" 2>/dev/null || continue
    ps -p "$_pid" -o command= 2>/dev/null | grep -q gai-watch || continue
    _repo=$(awk '{print $2}' "$_pf" 2>/dev/null)
    _seen=$(stat -f %m "/tmp/gai-watch-seen-$(echo "$_repo" | md5)" 2>/dev/null || echo 0)
    _live+=("$_seen $_pid $_repo")
  done
  _excess=$(( ${#_live[@]} + 1 - WATCH_MAX ))
  if (( _excess > 0 )); then
    while read -r _ _pid _repo; do
      echo "$(date '+%H:%M:%S') cap of $WATCH_MAX watchers reached — stopping the least recently used: $_repo"
      kill "$_pid" 2>/dev/null || true
    done < <(printf '%s\n' "${_live[@]}" | sort -n | head -n "$_excess")
  fi
fi

# Stop when the repo has gone unvisited: no shell entered it and nothing touched
# its index for GAI_WATCH_IDLE_HOURS (default 24, 0 = never). The next cd into
# the repo starts a fresh watcher.
IDLE_HOURS="${GAI_WATCH_IDLE_HOURS:-24}"
IDLE_PID=""
if [[ "$IDLE_HOURS" =~ ^[0-9]+$ ]] && (( IDLE_HOURS > 0 )); then
  (
    while sleep "${GAI_WATCH_IDLE_TICK:-600}"; do
      if [[ -n "$(find "$SEEN_FILE" -mmin +$(( IDLE_HOURS * 60 )) 2>/dev/null)" ]]; then
        echo "$(date '+%H:%M:%S') idle: no visit or index change in ${IDLE_HOURS}h — stopping (repo:$REPO_ROOT)"
        kill -TERM $$ 2>/dev/null
        exit 0
      fi
    done
  ) &
  IDLE_PID=$!
fi

# Watch the whole $GIT_DIR (recursive) and filter down to index files rather than
# watching the $GIT_DIR/index path directly. Git never writes index in place — it
# writes index.lock and renames it over index — so a path watch is aimed at an
# inode that is replaced on every single `git add`. The directory watch survives
# that, and covers .git/modules/<name>/index for free, so submodules added after
# startup need no restart.
WATCH_TARGETS=("$GIT_DIR")
WATCH_FILTERS=(-e '.*' -i '/index$')

# Collect submodule roots for the startup banner only.
SUBMOD_COUNT=0
# shellcheck disable=SC2016
while IFS= read -r submod_path; do
  [[ -z "$submod_path" ]] && continue
  SUBMOD_COUNT=$((SUBMOD_COUNT + 1))
done < <(git -C "$REPO_ROOT" submodule --quiet foreach --recursive 'echo "$displaypath"' 2>/dev/null)

echo "👁  gai-watch active → $REPO_ROOT"
if [[ $SUBMOD_COUNT -gt 0 ]]; then
  echo "   + $SUBMOD_COUNT submodule(s) watched."
fi
echo "   Stage files in VS Code to auto-commit. Ctrl+C to stop."
echo ""

DEBOUNCE=2

_last_run_file() {
  local repo_hash
  repo_hash=$(echo "$1" | md5)
  echo "/tmp/gai-watch-lastrun-${repo_hash}"
}

# One pass over every repo (parent + submodules) for a single fswatch event.
_handle_trigger() {
  # Heartbeat: touch the PID file each pass so a wedged watcher is detectable by
  # age, not only by kill -0. The seen file counts index changes as use, so a repo
  # staged only from VS Code is never stopped as idle.
  touch "$PID_FILE" "$SEEN_FILE" 2>/dev/null || true

  # Re-enumerate submodules on every trigger so submodules added after startup
  # are handled without restarting gai-watch.
  local CURRENT_REPOS
  CURRENT_REPOS=("$REPO_ROOT")
  # shellcheck disable=SC2016
  while IFS= read -r submod_path; do
    [[ -z "$submod_path" ]] && continue
    CURRENT_REPOS+=("$REPO_ROOT/$submod_path")
  done < <(git -C "$REPO_ROOT" submodule --quiet foreach --recursive 'echo "$displaypath"' 2>/dev/null)

  for repo in "${CURRENT_REPOS[@]}"; do
    STAGED=$(git -C "$repo" diff --cached --name-only 2>/dev/null) || continue
    [[ -z "$STAGED" ]] && continue

    # Skip while another git process (Claude Code, IDE, user shell) is mid-operation —
    # racing it here collides on the index and can auto-commit half-finished work.
    # The next fswatch trigger will retry.
    repo_git_dir=$(git -C "$repo" rev-parse --git-dir 2>/dev/null) || continue
    [[ "$repo_git_dir" != /* ]] && repo_git_dir="$repo/$repo_git_dir"
    if [[ -f "$repo_git_dir/index.lock" ]]; then
      echo "$(date '+%H:%M:%S') skip: index.lock held (another git process active) in $(basename "$repo")"
      continue
    fi

    last_run_f=$(_last_run_file "$repo")
    last_run=$(cat "$last_run_f" 2>/dev/null || echo "0")
    NOW=$(date +%s)
    if (( NOW - last_run < 5 )); then
      echo "$(date '+%H:%M:%S') skip: throttled (<5s since last run) in $(basename "$repo")"
      continue
    fi
    echo "$NOW" > "$last_run_f"

    echo "━━━ $(date '+%H:%M:%S') staged: $(echo "$STAGED" | wc -l | tr -d ' ') file(s) in $(basename "$repo") ━━━"
    # stdin comes from /dev/null, never the fswatch pipe: anything gai reads from
    # an inherited stdin drains that pipe, the read loop below sees EOF, and the
    # watcher exits 0 with nothing in the log — issue #28's silent death.
    (cd "$repo" && gai ${EXTRA_ARGS[@]+"${EXTRA_ARGS[@]}"} < /dev/null) || true
    echo ""
  done
}

# Re-arm forever. If fswatch exits for any reason the pipeline closes, the read
# loop ends, and under `set -euo pipefail` the script would exit 0 in silence.
# Restart it instead, and say so.
PIPELINE_PID=""
while true; do
  (
    fswatch -o --latency "$DEBOUNCE" "${WATCH_FILTERS[@]}" "${WATCH_TARGETS[@]}" | while read -r _; do
      _handle_trigger
    done
  ) &
  PIPELINE_PID=$!
  wait "$PIPELINE_PID" || true
  echo "$(date '+%H:%M:%S') fswatch exited — restarting in 2s (repo:$REPO_ROOT)"
  sleep 2
done
